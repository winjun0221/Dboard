{
  "name": "dboard",
  "productName": "DBoard",
  "version": "0.1.0",
  "description": "DB 관리 도구",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run && node scripts/i18n-check.mjs",
    "test:db": "node scripts/test-dbs.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && npm run notices && electron-builder --win --publish never",
    "serve-updates": "node scripts/serve-updates.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "type": "module",
  "author": "DBoard",
  "homepage": "https://github.com/winjun0221/dboard",
  "license": "MIT",
  "build": {
    "appId": "app.dboard.desktop",
    "productName": "DBoard",
    "copyright": "Copyright © 2026 DBoard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DBoard",
      "artifactName": "DBoard-Setup-${version}.${ext}",
      "uninstallDisplayName": "DBoard",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "DBoard-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/winjun0221/dboard/releases/latest/download/"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.108.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "codemirror": "^6.0.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.76.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "playwright-core": "^1.65.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.10.0",
    "ssh2": "^1.17.0",
    "tedious": "^20.3.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "ssh2": false
  }
}
